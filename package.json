{
  "name": "ticket-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "رصد و رزرو خودکار بلیت قطار رجا تا مرحله درگاه بانک",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "dev:login": "tsx scripts/login.ts",
    "dev:search": "tsx scripts/search.ts",
    "dev:sms": "tsx scripts/sms.ts",
    "web:dev": "npm --prefix web run dev",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^11.3.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.12.3",
    "jalaliday": "^3.1.1",
    "playwright": "^1.47.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}